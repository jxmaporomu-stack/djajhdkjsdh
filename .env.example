# 디스호스트 환경변수에 입력하세요. TOKEN은 직접 등록하세요.
TOKEN=YOUR_DISCORD_BOT_TOKEN
MASTER_ID=1193169140576419882
BOT_NAME=자판기
LICENSE_PREFIX=VEND

# 자판기/출퇴근은 서버 ID 제한 없이 각 서버의 일반/프리미엄 라이센스로 사용합니다.
# GUILD_ID는 이전 설정 호환용이며 자판기 서버를 제한하지 않습니다.
GUILD_ID=1497449054702141590
# 이 목록에 있는 서버는 자판기 라이센스 검사 면제 (기존 설정을 유지하세요).
FREE_GUILD_IDS=1497449054702141590

# 공통 SQLite 저장소
DB_PATH=./data.db

# 슬롯 서버는 config.json의 guildId로 지정됨
ENABLE_SLOTS=true

# 인증 및 백업 활성화 (같은 TOKEN 사용)
ENABLE_BACKUP=true
CLIENT_ID=
CLIENT_SECRET=
SOURCE_GUILD=
BACKUP_GUILD=
SOURCE_ROLE=
BACKUP_ROLE=
REDIRECT_URI=https://YOUR-DOMAIN/oauth/callback
DATA_KEY=
BACKUP_DB_PATH=./data/backup.sqlite
PORT=3000
